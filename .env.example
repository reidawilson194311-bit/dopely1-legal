# ---------------------------------------------------------------------------
# THE MACHINE - scrape, reword, design, post.
# Copy to .env and fill in. Every key is optional for `--dry-run`.
# ---------------------------------------------------------------------------

# Where posts go. Any subset of: instagram,tiktok,youtube
PLATFORMS=instagram,tiktok,youtube

# json = flat files under DATA_DIR (no accounts needed). airtable = shared base.
STORE_DRIVER=json
DATA_DIR=./data
OUT_DIR=./out
LOG_LEVEL=info

# --- SKILL 01 / THE RESEARCHER ---------------------------------------------
# apify.com -> Settings -> Integrations -> API tokens
APIFY_TOKEN=
APIFY_ACTOR_INSTAGRAM=apify~instagram-scraper
APIFY_ACTOR_TIKTOK=clockworks~tiktok-scraper
APIFY_ACTOR_YOUTUBE=streamers~youtube-scraper
RESEARCH_POSTS_PER_ACCOUNT=12
RESEARCH_LOOKBACK_DAYS=90
# A post is a winner at >= this multiple of its own account's median views.
RESEARCH_VIRAL_MULTIPLE=3
RESEARCH_MIN_VIEWS=100000
RESEARCH_KEEP_TOP=40

# --- SKILL 02 / THE COPYWRITER ---------------------------------------------
# console.anthropic.com -> API keys. Or run `ant auth login` and leave blank.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=16000
COPY_BATCH_SIZE=6
COPY_BEATS=6

# --- SKILL 03 / THE DESIGNER -----------------------------------------------
# aistudio.google.com -> Get API key. "nano banana" is Gemini's image model.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image
# editorial-bold | flat-graphic | retro-print
DESIGN_STYLE=editorial-bold
DESIGN_BATCH_SIZE=4
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
# Needs a build with libfreetype, or captions are not burned in.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CAPTION_FONT=
# none | elevenlabs | openai-compatible
TTS_PROVIDER=none
TTS_API_KEY=
TTS_VOICE_ID=
TTS_BASE_URL=
MUSIC_FILE=
MUSIC_VOLUME=0.12

# --- SKILL 04 / THE POSTER -------------------------------------------------
# none | metricool | unipile   (none = schedule locally, publish nothing)
PUBLISH_PROVIDER=none
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_ACCOUNT_INSTAGRAM=
UNIPILE_ACCOUNT_TIKTOK=
UNIPILE_ACCOUNT_YOUTUBE=
# Distinct videos per run. Each is cross-posted to every platform, so 2 here
# means 2 posts per account per day, not 6. The rate climbs from PUBLISH_PER_RUN
# to PUBLISH_RAMP_TO over PUBLISH_RAMP_DAYS, measured from the first post the
# machine ever scheduled - a new account that opens at full cadence looks like
# a bot to the platforms.
PUBLISH_PER_RUN=2
PUBLISH_RAMP_TO=4
PUBLISH_RAMP_DAYS=21
PUBLISH_TIMEZONE=America/New_York
SLOTS_INSTAGRAM=11:00,19:00
SLOTS_TIKTOK=09:00,18:00,21:00
SLOTS_YOUTUBE=12:00,17:00
PUBLISH_LEAD_MINUTES=45
PUBLISH_HORIZON_DAYS=7

# --- Airtable (only when STORE_DRIVER=airtable) -----------------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_WINNERS=Winners
AIRTABLE_TABLE_SCRIPTS=Scripts
AIRTABLE_TABLE_RENDERS=Renders
AIRTABLE_TABLE_POSTS=Posts
